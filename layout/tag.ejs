<% if (page.tag) { %>
<%- partial('archive', { archiveTitle: __('tags') + ': ' + page.tag }) %>
<% } else { %>
<div class="tag-page">
  <h1 class="page-title"><%= __('tags') %></h1>
  <div class="tag-cloud">
    <% visible_taxonomy('tags').forEach(function(tag){ %>
      <a href="<%- url_for(tag.path) %>" style="font-size: <%- Math.max(0.8, 1 + tag.posts.length * 0.1) %>rem"><%= tag.name %></a>
    <% }) %>
  </div>
</div>
<% } %>
