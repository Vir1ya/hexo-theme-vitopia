<% if (page.category) { %>
<%- partial('archive', { archiveTitle: __('categories') + ': ' + page.category }) %>
<% } else { %>
<div class="category-page">
  <h1 class="page-title"><%= __('categories') %></h1>
  <ul class="category-list">
    <% visible_taxonomy('categories').forEach(function(cat){ %>
      <li class="category-item">
        <a href="<%- url_for(cat.path) %>">
          <%= cat.name %>
          <span class="category-count"><%= cat.posts.length %></span>
        </a>
      </li>
    <% }) %>
  </ul>
</div>
<% } %>
