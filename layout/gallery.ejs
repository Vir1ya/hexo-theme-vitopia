<section class="gallery-page">
  <header class="gallery-heading"><h1><%= __('gallery') %></h1></header>
  <% if (page.galleryImages.length) { %>
    <% if (page.galleryTags.length) { %>
      <div class="gallery-filters" role="group" aria-label="<%= __('gallery_filter') %>">
        <button type="button" data-gallery-filter="" aria-pressed="true"><%= __('gallery_all') %></button>
        <% page.galleryTags.forEach(function (tag) { %>
          <button type="button" data-gallery-filter="<%= tag %>" aria-pressed="false"><%= tag %></button>
        <% }); %>
      </div>
    <% } %>
    <div class="gallery-grid">
      <% page.galleryImages.forEach(function (image, index) { var src = /^https?:/.test(image.src) ? image.src : url_for(image.src); %>
        <figure class="gallery-item" data-gallery-tags="<%= JSON.stringify(image.tags) %>">
          <a class="gallery-image-link" href="<%= src %>" target="_blank" rel="noopener noreferrer" aria-label="<%= image.alt || image.caption || __('gallery_original') %>" aria-haspopup="dialog"<% if (image.caption) { %> aria-describedby="gallery-description-<%= index %>"<% } %>>
            <img src="<%= src %>" alt="<%= image.alt %>" loading="lazy" decoding="async">
            <% if (image.caption) { %><span class="gallery-description" id="gallery-description-<%= index %>"><%= image.caption %></span><% } %>
          </a>
          <template class="gallery-author-text"><%- image.textHtml %></template>
          <% if (image.tags.length) { %>
            <figcaption><div class="gallery-tags"><% image.tags.forEach(function (tag) { %><span><%= tag %></span><% }); %></div></figcaption>
          <% } %>
        </figure>
      <% }); %>
    </div>
    <p class="gallery-filter-empty" hidden><%= __('gallery_no_matches') %></p>
    <dialog class="gallery-viewer" aria-label="<%= __('gallery_viewer') %>">
      <div class="gallery-viewer-content">
        <div class="gallery-viewer-toolbar">
          <a data-gallery-original target="_blank" rel="noopener noreferrer"><%= __('gallery_original_file') %> ↗</a>
          <button type="button" data-gallery-close autofocus><%= __('gallery_close') %> ×</button>
        </div>
        <img class="gallery-viewer-image" alt="">
        <div class="gallery-viewer-text" hidden></div>
      </div>
    </dialog>
  <% } else { %>
    <p class="gallery-empty"><%= __('gallery_empty') %></p>
  <% } %>
</section>
