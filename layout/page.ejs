<article class="post-card single h-entry" itemscope itemtype="http://schema.org/BlogPosting">
  <div class="post-card-inner">
    <header class="post-header">
      <h1 class="post-title p-name" itemprop="name headline"><%= page.title %></h1>
    </header>
    <div class="post-body e-content" itemprop="articleBody">
      <%- page.content %>
    </div>
  </div>
</article>
