<article class="post-card h-entry<%= index ? '' : ' single' %>" itemscope itemtype="http://schema.org/BlogPosting">
  <div class="post-card-inner">
    <header class="post-header">
      <% if (!index && post.cover) { %>
        <img class="post-cover" src="<%= post.cover %>" alt="cover">
      <% } %>
      <%- partial('post/title') %>
      <div class="post-meta">
        <%- partial('post/date') %>
        <%- partial('post/category') %>
      </div>
    </header>

    <% if (!index && post.music) { %>
      <div class="music-player-wrapper collapsed" id="music-player-wrapper">
        <button class="music-toggle" id="music-toggle" type="button" title="聆听本文音乐" aria-label="切换音乐播放器" aria-expanded="false">
          <span class="music-toggle-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l10-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="16" cy="16" r="3"/></svg>
          </span>
          <span class="music-toggle-label">Listen</span>
        </button>
        <div id="music-player" class="music-player"></div>
      </div>
    <% } %>

    <div class="post-body e-content" itemprop="articleBody">
      <% if (index) { %>
        <% if (post.excerpt) { %>
          <%- post.excerpt %>
        <% } else { %>
          <p><%- strip_html(post.content).substring(0, 80) %>...</p>
        <% } %>
        <a class="read-more" href="<%- url_for(post.path) %>"><%= __('read_more') %> →</a>
      <% } else { %>
        <%- post.content %>
      <% } %>
    </div>

    <% if (!index || (post.tags && post.tags.length)) { %>
      <footer class="post-footer">
        <% if (post.tags && post.tags.length) { %>
          <%- partial('post/tag') %>
        <% } else { %>
          <div class="post-tags"></div>
        <% } %>
        <% if (!index) { %>
          <div class="share-widget">
            <div class="share-items">
              <a class="share-item share-item-qzone" title="QQ 空间" data-platform="qzone">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5l2.1 6.5h6.9l-5.6 4 2.1 6.5-5.6-4-5.6 4 2.1-6.5-5.6-4h6.9z"/></svg>
              </a>
              <a class="share-item share-item-qq" title="QQ 好友" data-platform="qq">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6.75 7.5c0-2.9 2.35-5.25 5.25-5.25s5.25 2.35 5.25 5.25c0 1.7-.8 3.2-2.05 4.15.6.15 1.2.35 1.75.6 1.55.7 2.8 1.85 2.8 3.25v1.5c0 .3-.25.5-.5.5H4.75c-.25 0-.5-.2-.5-.5v-1.5c0-1.4 1.25-2.55 2.8-3.25.55-.25 1.15-.45 1.75-.6-1.25-.95-2.05-2.45-2.05-4.15z"/></svg>
              </a>
              <a class="share-item share-item-save-image" title="<%= __('save_as_image') %>" data-action="save-image" href="javascript:void(0)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
              </a>
            </div>
            <button class="share-toggle">
              <svg class="share-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            </button>
          </div>
        <% } %>
      </footer>
    <% } %>
  </div>
</article>
