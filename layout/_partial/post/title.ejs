<% if (post.title) { %>
  <% if (index) { %>
    <h2 class="post-title p-name" itemprop="name headline">
      <a class="post-title-link" href="<%- url_for(post.path) %>" itemprop="url"><%= post.title %></a>
    </h2>
  <% } else { %>
    <h1 class="post-title p-name" itemprop="name headline"><%= post.title %></h1>
  <% } %>
<% } %>
