<% if (post.tags && post.tags.length) { %>
  <div class="post-tags">
    <% post.tags.each(function(tag){ %>
      <% if (taxonomy_is_linked(tag)) { %><a class="post-tag" href="<%- url_for(tag.path) %>">#<%= tag.name %></a><% } else { %><span class="post-tag">#<%= tag.name %></span><% } %>
    <% }) %>
  </div>
<% } %>
