<% if (post.categories && post.categories.length) { %>
  <span class="post-categories">
    <% post.categories.each(function(cat){ %>
      <% if (taxonomy_is_linked(cat)) { %><a class="post-category" href="<%- url_for(cat.path) %>"><%= cat.name %></a><% } else { %><span class="post-category"><%= cat.name %></span><% } %>
    <% }) %>
  </span>
<% } %>
