<% if (page.total > 1) { %>
  <nav class="pagination">
    <%- paginator({
      prev_text: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg> ' + __('prev'),
      next_text: __('next') + ' <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>',
      escape: false,
      space: '&nbsp;'
    }) %>
  </nav>
<% } %>
