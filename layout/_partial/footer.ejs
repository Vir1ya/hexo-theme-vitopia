<button class="back-to-top" id="back-to-top" aria-label="Back to top" title="Back to top">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg>
</button>

<footer class="site-footer">
  <div class="container">
    <div class="footer-left">
      <% var year = theme.since ? theme.since + '–' + date(Date.now(), 'YYYY') : date(Date.now(), 'YYYY'); %>
      <span>&copy; <%= year %> <%= theme.author || config.author %></span>
    </div>
    <div class="footer-right">
      <span><%= __('powered_by') %> <a href="https://hexo.io" target="_blank" rel="noopener">Hexo</a></span>
      <span class="footer-sep">|</span>
      <span><%= __('theme') %> <a href="https://github.com/Vir1ya/hexo-theme-vitopia" target="_blank" rel="noopener">Vitopia</a></span>
    </div>
  </div>
</footer>
