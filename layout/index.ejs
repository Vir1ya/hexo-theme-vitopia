<div class="home-banner">
  <div class="home-banner-bg"></div>
  <div class="home-banner-content">
    <div class="home-hero">
      <% if (theme.avatar) { %>
        <img class="home-avatar" src="<%= theme.avatar %>" alt="avatar">
      <% } %>
      <a href="<%- url_for('/about') %>" class="home-author-link" data-pixel-name="<%= theme.pixel_name || '' %>"><%= theme.author || config.author %></a>
      <% if (theme.bio) { %>
        <p class="home-bio-desc"><%= theme.bio %></p>
      <% } %>
      <div class="home-icons">
        <% if (theme.social) { %>
          <% for (var name in theme.social) { %>
            <a href="<%= theme.social[name] %>" target="_blank" rel="noopener" class="home-icon-link" aria-label="<%= name %>"><%- socialIcon(name) %></a>
          <% } %>
        <% } %>
        <a href="mailto:<%= theme.email || '#' %>" class="home-icon-link" aria-label="Email">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 4L12 13 2 4"/></svg>
        </a>
        <a href="<%- url_for('/atom.xml') %>" class="home-icon-link" aria-label="RSS">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
        </a>
      </div>
    </div>
  </div>
</div>

<div class="posts-list">
  <% page.posts.each(function(post){ %>
    <%- partial('_partial/article', {post: post, index: true}) %>
  <% }) %>
</div>
<%- partial('_partial/pagination') %>
