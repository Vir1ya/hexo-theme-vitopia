// ===============
// Silver Pixel Font
// ===============
// Download Silver.ttf from https://poppyworks.itch.io/silver
// Place it in source/fonts/Silver.ttf
@font-face {
  font-family: 'Silver';
  src: url('/fonts/Silver.ttf') format('truetype');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}

// ===============
// Pixel Mode (Konami Code)
// ===============
[data-pixel="true"] {
  --pixel-font: 'Silver', 'Press Start 2P', monospace;
  --font-sans: var(--pixel-font);
  --font-serif: var(--pixel-font);
  --font-mono: var(--pixel-font);
  --font-body: var(--pixel-font);
  --font-size-base: 21px;
  --font-size-sm: 14px;
  --font-size-xs: 11px;
  --font-size-lg: 22px;
  --font-size-xl: 24px;
  --font-size-2xl: 27px;
  --font-size-3xl: 30px;
  --font-size-4xl: 33px;
  --border-radius: 0;
  --line-height: 1.8;
  --line-height-heading: 1.3;
  --transition: 0.05s step-end;
  --transition-slow: 0.05s step-end;

  // Default pixel: light cyan bg + blue text + deep navy accent
  --color-bg: #C0EAE6;
  --color-bg-secondary: #E6F6F4;
  --color-text: #1A5090;
  --color-text-secondary: #3068A8;
  --color-text-muted: #6A90B8;
  --color-border: #0D2050;
  --color-link: #0D2050;
  --color-link-hover: #1A3A70;
  --color-accent: #0D2050;
  --color-accent-dim: rgba(13, 32, 80, 0.08);
  --color-code-bg: rgba(13, 32, 80, 0.06);
  --color-code-text: #0D2050;
  --color-inline-code-bg: rgba(13, 32, 80, 0.12);
  --color-inline-code-text: #0D2050;
  --color-header-bg: rgba(192, 234, 230, 0.95);
  --color-overlay: rgba(13, 32, 80, 0.5);
  --color-date-accent: #0D2050;

  // ---- Layout ----
  .site-header {
    border-bottom: 4px solid var(--color-border);
    box-shadow: 0 4px 0 var(--color-border);
  }

  .home-hero {
    padding: var(--spacing-xl) 0 var(--spacing-2xl);
  }

  // ---- Cards ----
  .post-card {
    border: 4px solid var(--color-border) !important;
    border-radius: 0 !important;
    box-shadow: 6px 6px 0 var(--color-border) !important;
    padding: var(--spacing-md) !important;
    margin-bottom: var(--spacing-xl);
    background: var(--color-bg-secondary) !important;

    &:hover {
      transform: translate(-2px, -2px) !important;
      box-shadow: 8px 8px 0 var(--color-border) !important;
      border-color: var(--color-accent) !important;
    }
  }

  .post-card.single {
    border: none !important;
    box-shadow: none !important;

    &:hover {
      transform: none !important;
      box-shadow: none !important;
    }
  }

  // ---- Post nav blocks ----
  .post-nav-prev a,
  .post-nav-next a {
    border: 4px solid var(--color-border) !important;
    border-radius: 0 !important;
    box-shadow: 4px 4px 0 var(--color-border) !important;

    &:hover {
      transform: translate(-2px, -2px) !important;
      box-shadow: 6px 6px 0 var(--color-border) !important;
      border-color: var(--color-accent) !important;
    }
  }

  // ---- Search & code blocks ----
  .search-modal,
  figure.highlight {
    border: 4px solid var(--color-border) !important;
    box-shadow: 6px 6px 0 var(--color-border);
    border-radius: 0 !important;
  }

  // ---- Buttons & badges ----
  .btn-icon, .copy-btn, .post-category {
    border: 2px solid var(--color-border);
    box-shadow: 3px 3px 0 var(--color-border);
    image-rendering: pixelated;

    &:active {
      box-shadow: none;
      transform: translate(3px, 3px);
    }
  }

  .post-category {
    color: var(--color-accent);
    background: var(--color-accent-dim);
  }

  // ---- Home icons ----
  .home-icon-link {
    border: 2px solid var(--color-border);
    box-shadow: 3px 3px 0 var(--color-border);
    border-radius: 0 !important;

    &:hover {
      box-shadow: 4px 4px 0 var(--color-border);
      background: var(--color-accent-dim);
    }

    &:active {
      box-shadow: none;
      transform: translate(3px, 3px);
    }
  }

  // ---- Typography ----
  .site-title,
  .nav-link {
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .home-author-link {
    letter-spacing: 0.1em;
    color: var(--color-link);

    &:hover {
      color: var(--color-link-hover);
    }
  }

  // ---- Code text explicit override ----
  figure.highlight {
    background: var(--color-code-bg);

    .code pre {
      color: var(--color-code-text);
    }

    .gutter {
      background: rgba(0, 0, 0, 0.1);
      border-right: 2px solid var(--color-border);

      pre {
        color: var(--color-text-muted);
      }
    }
  }

  .code-header {
    background: rgba(0, 0, 0, 0.1);
    border-bottom: 2px solid var(--color-border);
  }

  code {
    color: var(--color-inline-code-text);
    background: var(--color-inline-code-bg);
  }

  // ---- Selection ----
  ::selection {
    background: var(--color-accent);
    color: var(--color-bg);
  }
}

// ===============
// Pixel Light Mode (dark mode toggle)
// ===============
[data-pixel="true"][data-theme="dark"] {
  --color-bg: #FCF8F8;
  --color-bg-secondary: #FBEFEF;
  --color-text: #898AC4;
  --color-text-secondary: #F5AFAF;
  --color-text-muted: #D8B0B0;
  --color-border: #F5AFAF;
  --color-link: #898AC4;
  --color-link-hover: #F5AFAF;
  --color-accent: #898AC4;
  --color-accent-dim: rgba(137, 138, 196, 0.15);
  --color-code-bg: #FBEFEF;
  --color-code-text: #898AC4;
  --color-inline-code-bg: rgba(137, 138, 196, 0.15);
  --color-inline-code-text: #6A6BB0;
  --color-header-bg: rgba(252, 248, 248, 0.95);
  --color-overlay: rgba(252, 248, 248, 0.9);
  --color-date-accent: #F5AFAF;
}

