// ===============
// Minimal type-first variables
// ===============
:root {
  --color-bg: #fafaf8;
  --color-bg-secondary: #f0f0ee;
  --color-text: #1a1a1a;
  --color-text-secondary: #555555;
  --color-text-muted: #999999;
  --color-border: #d5d5d5;
  --color-link: #b83a2a;
  --color-link-hover: #8b1a1a;
  --color-accent: #b83a2a;
  --color-accent-dim: rgba(184, 58, 42, 0.08);
  --color-code-bg: #f0f0ee;
  --color-code-text: #333333;
  --color-inline-code-bg: #f0f0ee;
  --color-inline-code-text: #b83a2a;
  --color-header-bg: rgba(250, 250, 248, 0.92);
  --color-shadow: rgba(0, 0, 0, 0.04);
  --color-overlay: rgba(0, 0, 0, 0.45);
  --color-date-accent: #b83a2a;

  --font-roman: 'Times New Roman', Times, serif;
  --font-cjk: 'Noto Serif SC', 'Songti SC', 'SimSun', serif;
  --font-serif: var(--font-roman), var(--font-cjk);
  --font-sans: var(--font-serif);
  --font-display: var(--font-serif);
  --font-body: var(--font-serif);
  --font-mono: 'Times New Roman', 'Noto Serif SC', monospace;
  --font-size-base: 18px;
  --font-size-xs: 0.72rem;
  --font-size-sm: 0.84rem;
  --font-size-lg: 1.08rem;
  --font-size-xl: 1.28rem;
  --font-size-2xl: 1.58rem;
  --font-size-3xl: 2rem;
  --font-size-4xl: 2.4rem;
  --line-height: 1.86;
  --line-height-heading: 1.28;

  --spacing-xs: 0.25rem;
  --spacing-sm: 0.5rem;
  --spacing-md: 1rem;
  --spacing-lg: 1.5rem;
  --spacing-xl: 2rem;
  --spacing-2xl: 3rem;
  --spacing-3xl: 4rem;
  --spacing-4xl: 6rem;

  --container-width: 680px;
  --header-height: 56px;
  --border-radius: 4px;

  --transition: 0.3s ease;
  --transition-slow: 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}
