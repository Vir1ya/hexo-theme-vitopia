:root {
  // Colors — warm light theme
  --color-bg: #fffef9;
  --color-bg-secondary: #faf8f3;
  --color-text: #2c2416;
  --color-text-secondary: #6b5e4a;
  --color-text-muted: #b0a596;
  --color-border: #e8e0d5;
  --color-link: #b4651c;
  --color-link-hover: #8b4a10;
  --color-accent: #c9772e;
  --color-accent-dim: rgba(201, 119, 46, 0.08);
  --color-code-bg: #f4efe6;
  --color-code-text: #3d3526;
  --color-inline-code-bg: #f4efe6;
  --color-inline-code-text: #b35c00;
  --color-header-bg: rgba(255, 254, 249, 0.9);
  --color-shadow: rgba(44, 36, 22, 0.04);
  --color-overlay: rgba(44, 36, 22, 0.5);
  --color-date-accent: #c9772e;

  // Banner gradient
  --banner-gradient-start: #e8d5b0;
  --banner-gradient-mid: #f0e4cc;
  --banner-gradient-end: #fffef9;

  // Typography
  --font-sans: 'Inter', 'Noto Sans SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-serif: 'Times New Roman', 'Noto Serif SC', 'Georgia', serif;
  --font-body: var(--font-serif);
  --font-mono: 'JetBrains Mono', 'Source Code Pro', Consolas, Monaco, monospace;
  --font-pixel: 'Press Start 2P', monospace;
  --font-size-base: 18px;
  --font-size-sm: 0.833rem;
  --font-size-xs: 0.722rem;
  --font-size-lg: 1.111rem;
  --font-size-xl: 1.333rem;
  --font-size-2xl: 1.667rem;
  --font-size-3xl: 2.111rem;
  --font-size-4xl: 2.667rem;
  --line-height: 1.8;
  --line-height-heading: 1.25;

  // Spacing
  --spacing-xs: 0.25rem;
  --spacing-sm: 0.5rem;
  --spacing-md: 1rem;
  --spacing-lg: 1.5rem;
  --spacing-xl: 2rem;
  --spacing-2xl: 3rem;
  --spacing-3xl: 4rem;
  --spacing-4xl: 6rem;

  // Layout
  --container-width: 680px;
  --header-height: 56px;
  --border-radius: 4px;

  // Transitions
  --transition: 0.2s ease;
  --transition-slow: 0.3s ease;
}
