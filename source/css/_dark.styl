// ===============
// Dark mode
// ===============
[data-theme="dark"] {
  --color-bg: #1a1a1a;
  --color-bg-secondary: #222222;
  --color-text: #e0e0e0;
  --color-text-secondary: #a0a0a0;
  --color-text-muted: #6a6a6a;
  --color-border: #3a3a3a;
  --color-link: #d4735a;
  --color-link-hover: #e89880;
  --color-accent: #d4735a;
  --color-accent-dim: rgba(212, 115, 90, 0.1);
  --color-code-bg: #252525;
  --color-code-text: #d0d0d0;
  --color-inline-code-bg: #2a2a2a;
  --color-inline-code-text: #d4735a;
  --color-header-bg: rgba(26, 26, 26, 0.92);
  --color-overlay: rgba(0, 0, 0, 0.72);
  --color-date-accent: #d4735a;
}

[data-theme="dark"] {
  .search-modal,
  .back-to-top,
  .share-toggle,
  .share-item {
    background: var(--color-bg);
  }

  .hljs-comment,
  .hljs-quote { color: #6a6a6a; }
  .hljs-variable,
  .hljs-template-variable,
  .hljs-attribute,
  .hljs-tag,
  .hljs-name,
  .hljs-selector-id,
  .hljs-selector-class,
  .hljs-regexp,
  .hljs-link { color: #d0a080; }
  .hljs-number,
  .hljs-meta,
  .hljs-built_in,
  .hljs-type,
  .hljs-params { color: #80b0c8; }
  .hljs-string,
  .hljs-symbol,
  .hljs-bullet { color: #98c080; }
  .hljs-title,
  .hljs-section { color: #c0a0d8; }
  .hljs-keyword,
  .hljs-selector-tag { color: var(--color-accent); }
  .hljs-literal { color: #d0a080; }
  .hljs-deletion { color: #d08070; background: rgba(208, 128, 112, 0.08); }
  .hljs-addition { color: #98c080; background: rgba(152, 192, 128, 0.08); }
}
