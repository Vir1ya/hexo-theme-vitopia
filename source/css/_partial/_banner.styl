// ===============
// Homepage Banner
// ===============
.home-banner {
  position: relative;
  margin-top: calc(-1 * var(--header-height) - var(--spacing-3xl));
  margin-bottom: 0;
  padding-top: calc(var(--header-height) + var(--spacing-3xl));
  padding-bottom: 8vh;
  width: 100vw;
  margin-left: calc(-50vw + 50%);
}

.home-banner-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
  background: radial-gradient(ellipse 80% 70% at 50% 25%,
    var(--banner-gradient-start) 0%,
    var(--banner-gradient-mid) 50%,
    var(--banner-gradient-end) 100%);
  clip-path: ellipse(90% 80% at 70% 0);
  transition: background 0.8s ease;
}

// Hero content above gradient
.home-banner-content {
  position: relative;
  z-index: 2;
  max-width: var(--container-width);
  margin: 0 auto;
  padding: 0 var(--spacing-lg);
}

.home-hero {
  text-align: center;
  padding: var(--spacing-2xl) 0 var(--spacing-3xl);
}

// ===============
// Announcement
// ===============
.home-announcement {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  max-width: var(--container-width);
  margin: calc(-2 * var(--spacing-xl)) auto var(--spacing-xl);
  padding: var(--spacing-sm) var(--spacing-md);
  border: 1px solid var(--color-border);
  border-radius: 6px;
  font-size: var(--font-size-sm);
  font-family: var(--font-sans);
  color: var(--color-text-secondary);
}

.announcement-icon {
  flex-shrink: 0;
  color: var(--color-accent);
  display: flex;
  align-items: center;
}

// ===============
// Pixel Mode
// ===============
[data-pixel="true"] {
  .home-banner-bg {
    // Lighter blue center instead of deep navy
    background: radial-gradient(ellipse 80% 70% at 50% 25%,
      #6BAED6 0%,
      var(--color-accent-dim) 50%,
      var(--color-bg-secondary) 100%);
    clip-path: polygon(
      0%   0%,
      100% 0%,
      100% 43%,
      93%  43%,
      93%  56%,
      86%  56%,
      86%  67%,
      79%  67%,
      79%  76%,
      72%  76%,
      72%  83%,
      65%  83%,
      65%  88%,
      58%  88%,
      58%  92%,
      51%  92%,
      51%  95%,
      44%  95%,
      44%  97%,
      37%  97%,
      37%  99%,
      30%  99%,
      30%  100%,
      0%   100%
    );
    transition: background 1.2s steps(5, end);
  }
}
