// ===============
// Homepage
// ===============
.home-stage {
  position: relative;
  z-index: 0;
  min-height: calc(100vh - var(--header-height) - var(--spacing-3xl));
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: calc(var(--spacing-xl) + var(--spacing-sm) + 15px) 0 var(--spacing-2xl);
  isolation: isolate;
}

.home-field {
  position: fixed;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  opacity: 0.68;
  pointer-events: none;
}

.home-profile {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 430px;
  text-align: center;
}

.home-rise {
  opacity: 0;
  transform: translateY(22px);
  animation: homeRise 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.home-d1 { animation-delay: 0.12s; }
.home-d2 { animation-delay: 0.24s; }
.home-d3 { animation-delay: 0.36s; }
.home-d4 { animation-delay: 0.48s; }
.home-d5 { animation-delay: 0.6s; }
.home-d6 { animation-delay: 0.72s; }

@keyframes homeRise {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.home-avatar-wrap {
  position: relative;
  display: inline-block;
  min-width: 104px;
  min-height: 104px;
  margin-bottom: var(--spacing-xl);
}

.home-avatar {
  width: 104px;
  height: 104px;
  object-fit: cover;
  margin: 0 auto;
  border: 0;
  border-radius: 50%;
  filter: grayscale(0.28);
  cursor: pointer;
  transition: filter var(--transition-slow), transform var(--transition-slow);

  &:hover {
    filter: grayscale(0);
  }
}

.home-avatar-ring {
  position: absolute;
  inset: -7px;
  border: 1px solid var(--color-text-muted);
  border-radius: 50%;
  opacity: 0.45;
  pointer-events: none;
  animation: homeBreathe 4s ease-in-out infinite;
}

@keyframes homeBreathe {
  0%, 100% {
    transform: scale(1);
    opacity: 0.4;
  }
  50% {
    transform: scale(1.035);
    opacity: 0.75;
  }
}

.home-author-link {
  display: block;
  width: max-content;
  max-width: 100%;
  margin: 0 auto var(--spacing-sm);
  color: var(--color-text);
  font-size: var(--font-size-3xl);
  font-family: var(--font-display);
  font-weight: 200;
  letter-spacing: 0.12em;

  &::after {
    content: '.';
    color: var(--color-accent);
  }

  &:hover {
    color: var(--color-text);
  }
}

.home-bio-desc {
  min-height: 1.6em;
  margin: 0 0 var(--spacing-xl);
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
  line-height: 1.8;
  letter-spacing: 0.06em;
}

.home-divider {
  width: 34px;
  height: 1px;
  margin: 0 auto var(--spacing-xl);
  background: linear-gradient(to right, transparent, var(--color-text-muted) 28%, var(--color-text-muted) 72%, transparent);
  opacity: 0.48;
}

.home-links {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-lg);
}

.home-link {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  color: var(--color-text-muted);
  transition: color var(--transition), opacity var(--transition);

  &:hover {
    color: var(--color-accent);

    .home-link-mark {
      transform: translateY(-2px);
    }
  }

  &:focus-visible {
    outline: 1px solid var(--color-accent);
    outline-offset: 4px;
  }
}

.home-link-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 19px;
  height: 19px;
  transition: transform var(--transition-slow);

  svg {
    width: 19px;
    height: 19px;
    display: block;
  }
}

.home-announcement {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-sm);
  margin-top: var(--spacing-xl);
  padding: var(--spacing-sm) 0;
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
  color: var(--color-text-secondary);
  font-size: var(--font-size-xs);
  line-height: 1.7;
  letter-spacing: 0.06em;

  .announcement-icon {
    display: inline-flex;
    color: var(--color-accent);
  }
}

.home-posts {
  position: relative;
  z-index: 1;
  max-width: 560px;
  margin: 0 auto;
  padding-bottom: var(--spacing-2xl);
}

.home-section-heading {
  display: flex;
  justify-content: center;
  margin-bottom: var(--spacing-lg);
  color: var(--color-text-muted);
  font-size: var(--font-size-xs);
  letter-spacing: 0.3em;
}

.home-section-dot {
  color: var(--color-accent);
}

.home-magnetic {
  will-change: transform;
}

.home-post-magnetic {
  position: relative;
  display: block;

  .post-card {
    border-top: 0;
  }

  & + .home-post-magnetic {
    margin-top: var(--spacing-xl);
    padding-top: var(--spacing-xl);

    &::before {
      position: absolute;
      top: 0;
      left: 50%;
      width: 52%;
      height: 1px;
      background: linear-gradient(to right, transparent, var(--color-border) 24%, var(--color-border) 76%, transparent);
      content: '';
      transform: translateX(-50%);
    }
  }

  .post-footer {
    margin-top: 1.25rem;
    padding-top: 0;
    border-top: 0;
  }

  .post-tags {
    align-items: center;

    &::before {
      color: var(--color-accent);
      content: '·';
      font-size: 1rem;
      line-height: 1;
    }
  }
}

.posts-list > .home-post-magnetic:first-child .post-card {
  border-top: 1px solid var(--color-border);
}

body:has(.home-stage) .site-header {
  opacity: 0.94;
}

body:has(.home-stage) .main-content {
  padding-top: calc(var(--header-height) + var(--spacing-xl));
}

@media (prefers-reduced-motion: reduce) {
  .home-rise,
  .home-avatar-ring {
    animation: none;
  }

  .home-rise {
    opacity: 1;
    transform: none;
  }
}
