// ===============
// Homepage Banner
// ===============
.home-banner {
  position: relative;
  margin-top: calc(-1 * var(--header-height) - var(--spacing-3xl));
  margin-bottom: var(--spacing-lg);
  padding-top: calc(var(--header-height) + var(--spacing-3xl));
  padding-bottom: 6vh;
  width: 100vw;
  margin-left: calc(-50vw + 50%);
}

.home-banner-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
  background: radial-gradient(ellipse 80% 70% at 50% 25%,
    var(--banner-gradient-start) 0%,
    var(--banner-gradient-mid) 50%,
    var(--banner-gradient-end) 100%);
  clip-path: ellipse(90% 80% at 70% 0);
  transition: background 0.8s ease;
}

// Theme-wash animation layer
.banner-wash-layer {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  animation: bannerWash 0.7s ease-in-out forwards;
}

@keyframes bannerWash {
  0%   { clip-path: inset(0 0 100% 0); }
  100% { clip-path: inset(0 0 0 0); }
}

// Hero content above gradient
.home-banner-content {
  position: relative;
  z-index: 2;
  max-width: var(--container-width);
  margin: 0 auto;
  padding: 0 var(--spacing-lg);
}

.home-hero {
  text-align: center;
  padding: var(--spacing-2xl) 0 var(--spacing-3xl);
}

// ===============
// Pixel Mode
// ===============
[data-pixel="true"] {
  .home-banner-bg {
    // Lighter blue center instead of deep navy
    background: radial-gradient(ellipse 80% 70% at 50% 25%,
      #6BAED6 0%,
      var(--color-accent-dim) 50%,
      var(--color-bg-secondary) 100%);
    clip-path: polygon(
      0%   0%,
      100% 0%,
      100% 43%,
      93%  43%,
      93%  56%,
      86%  56%,
      86%  67%,
      79%  67%,
      79%  76%,
      72%  76%,
      72%  83%,
      65%  83%,
      65%  88%,
      58%  88%,
      58%  92%,
      51%  92%,
      51%  95%,
      44%  95%,
      44%  97%,
      37%  97%,
      37%  99%,
      30%  99%,
      30%  100%,
      0%   100%
    );
    transition: none;
  }
}
