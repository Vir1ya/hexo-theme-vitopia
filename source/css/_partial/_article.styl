// ===============
// Posts
// ===============
.posts-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.post-card {
  background: transparent;
  border-top: 1px solid var(--color-border);
  padding: var(--spacing-xl) 4px;
  animation: fadeIn 0.35s ease both;
  transition: padding var(--transition-slow), border-color var(--transition), background var(--transition);

  &:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  &:hover {
    padding-left: 14px;
    border-color: var(--color-text-muted);
  }
}

.post-card.single {
  border-top: none;
  border-bottom: none;
  padding: 0;
  animation: none;

  &:hover {
    padding-left: 0;
    border-color: transparent;
  }
}

.post-card-inner {
  width: 100%;
}

.post-cover {
  width: 100%;
  max-height: 420px;
  object-fit: cover;
  margin-bottom: var(--spacing-xl);
  border: 1px solid var(--color-border);
}

.post-header {
  margin-bottom: var(--spacing-sm);
}

.post-title {
  margin-bottom: var(--spacing-xs);
  font-size: var(--font-size-xl);
  font-family: var(--font-display);
  font-weight: 400;
  line-height: var(--line-height-heading);
  letter-spacing: 0.02em;

  a {
    color: var(--color-text);

    &:hover {
      color: var(--color-accent);
    }
  }
}

.post-card.single .post-title {
  margin-bottom: var(--spacing-md);
  font-size: var(--font-size-3xl);
  text-align: center;
}

.post-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  color: var(--color-text-muted);
  font-size: var(--font-size-xs);
  letter-spacing: 0.08em;
}

.post-date a {
  color: var(--color-text-muted);

  &:hover {
    color: var(--color-accent);
  }
}

.post-categories {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-xs);
}

.post-category {
  display: inline-block;
  padding: 0 9px;
  border: 1px solid var(--color-border);
  border-radius: 999px;
  color: var(--color-text-secondary);
  background: transparent;
  font-size: var(--font-size-xs);
  line-height: 1.7;
  letter-spacing: 0.06em;

  &:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
}

.post-body {
  color: var(--color-text-secondary);
  line-height: var(--line-height);

  .read-more {
    display: inline-block;
    margin-top: var(--spacing-xs);
    color: var(--color-accent);
    font-size: var(--font-size-sm);
    letter-spacing: 0.05em;

    &:hover {
      color: var(--color-link-hover);
      transform: translateX(4px);
    }
  }
}

.post-card.single .post-body {
  color: var(--color-text);
}

// ===============
// Share
// ===============
.share-widget {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: flex-end;

  &::before {
    content: '';
    position: absolute;
    top: -6px;
    right: 0;
    bottom: -6px;
    width: 90px;
  }
}

.share-toggle,
.share-item {
  width: 28px;
  height: 28px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--color-border);
  border-radius: 50%;
  background: var(--color-bg);
  color: var(--color-text-muted);
  cursor: pointer;
  transition: color var(--transition), border-color var(--transition), transform var(--transition-slow), background var(--transition-slow);

  &:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }
}

.share-toggle {
  flex-shrink: 0;

  .share-icon {
    pointer-events: none;
  }
}

.share-items {
  position: absolute;
  right: 36px;
  display: flex;
  gap: 6px;
  opacity: 0;
  transform: translateX(4px);
  pointer-events: none;
  white-space: nowrap;
  transition: opacity 0.15s ease 0.25s, transform 0.15s ease 0.25s;
}

.share-widget:hover .share-items {
  opacity: 1;
  transform: translateX(0);
  pointer-events: auto;
  transition-delay: 0s;
}

.share-item.is-busy {
  width: auto;
  padding: 0 10px;
  pointer-events: none;
  font-size: var(--font-size-xs);
}

// ===============
// Footer, Tags, Nav
// ===============
.post-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--spacing-md);
  margin-top: var(--spacing-2xl);
  padding-top: var(--spacing-lg);
  border-top: 1px solid var(--color-border);
}

.post-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}

.post-tag {
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);

  &:hover {
    color: var(--color-accent);
  }
}

.post-nav {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--spacing-lg);
  margin-top: var(--spacing-3xl);
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);

  &-prev,
  &-next {
    min-width: 0;

    a {
      display: block;
      padding: var(--spacing-lg) 0;
      color: var(--color-text);
      transition: padding var(--transition-slow), color var(--transition);

      &:hover {
        color: var(--color-accent);
      }
    }
  }

  &-prev a:hover {
    padding-left: var(--spacing-sm);
  }

  &-next {
    text-align: right;

    a:hover {
      padding-right: var(--spacing-sm);
    }
  }

  &-label {
    display: block;
    margin-bottom: 4px;
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  &-title {
    display: block;
    color: inherit;
    font-size: var(--font-size-sm);
    word-break: break-word;
  }
}

.headerlink {
  opacity: 0;
  margin-left: var(--spacing-xs);
  color: var(--color-text-muted);
  font-size: 0.85em;
  transition: opacity var(--transition), color var(--transition);

  h2:hover &, h3:hover &, h4:hover & {
    opacity: 1;
  }

  &:hover {
    color: var(--color-accent);
  }
}

// ===============
// Music Player
// ===============
.music-player-wrapper {
  position: relative;
  margin: var(--spacing-xl) 0;

  &.collapsed {
    .music-player {
      grid-template-rows: 0fr;
      margin-top: 0;
      padding-top: 0;
      padding-bottom: 0;
      border-color: transparent;
      opacity: 0;
      pointer-events: none;
    }
  }
}

.music-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: flex-start;
  gap: var(--spacing-sm);
  width: 100%;
  padding: var(--spacing-sm) 0;
  border: none;
  background: transparent;
  color: var(--color-text-secondary);
  cursor: pointer;
  font: inherit;
  text-align: left;
  transition: color var(--transition), padding var(--transition-slow);

  &:hover {
    padding-left: var(--spacing-sm);
    color: var(--color-accent);

    .music-toggle-icon {
      transform: translateY(-1px);
    }
  }

  &:focus-visible {
    outline: 1px solid var(--color-accent);
    outline-offset: 4px;
  }
}

.music-toggle-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  color: var(--color-accent);
  transition: transform var(--transition-slow);

  svg {
    width: 18px;
    height: 18px;
  }
}

.music-toggle-label {
  font-family: var(--font-roman);
  font-size: var(--font-size-xs);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.music-player {
  display: grid;
  grid-template-rows: 1fr;
  overflow: hidden;
  margin-top: var(--spacing-sm);
  padding: var(--spacing-md) 0;
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
  opacity: 1;
  transition: grid-template-rows var(--transition-slow), margin var(--transition), padding var(--transition), border-color var(--transition), opacity var(--transition);

  > * {
    min-height: 0;
    overflow: hidden;
  }

  .aplayer {
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    color: inherit;
    font-family: inherit;
    margin: 0;
    padding: 0;

    .aplayer-pic { display: none; }

    .aplayer-info {
      border-bottom: none;
      padding: 0;
      margin: 0;

      .aplayer-music {
        display: flex;
        align-items: baseline;
        gap: var(--spacing-sm);
        padding: 0;
        margin-bottom: 6px;
        overflow: hidden;

        .aplayer-title {
          color: var(--color-text);
          font-size: var(--font-size-sm);
          font-weight: 400;
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }

        .aplayer-author {
          color: var(--color-text-muted);
          font-size: var(--font-size-xs);
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }
      }
    }

    .aplayer-controller {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);

      .aplayer-bar-wrap {
        flex: 1;
        margin: 0;
        padding: 0;

        .aplayer-bar {
          height: 2px;
          background: var(--color-border);
          border-radius: 0;

          .aplayer-loaded {
            background: var(--color-border);
            opacity: 0.35;
          }

          .aplayer-played {
            height: 2px;
            background: var(--color-accent);
            border-radius: 0;

            .aplayer-thumb { display: none; }
          }
        }
      }

      .aplayer-time {
        position: static;
        display: inline-flex;
        align-items: center;
        gap: 1px;
        height: auto;
        color: var(--color-text-muted);
        font-size: 11px;
        line-height: 1;

        .aplayer-icon {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          width: 26px;
          height: 26px;
          color: var(--color-text-secondary);

          svg { width: 16px; height: 16px; }
          &:hover { color: var(--color-accent); }

          &.aplayer-icon-menu,
          &.aplayer-icon-loop,
          &.aplayer-icon-lrc {
            display: none;
          }
        }

        .aplayer-volume-wrap,
        .aplayer-icon-volume-down,
        .aplayer-icon-volume-up {
          display: none;
        }
      }
    }

    .aplayer-lrc,
    .aplayer-list,
    .aplayer-miniswitcher,
    .aplayer-icon-back,
    .aplayer-icon-forward {
      display: none;
    }
  }
}

// ===============
// Archives, Categories, Tags
// ===============
.archive-timeline {
  position: relative;
  max-width: 640px;
  margin: 0 auto;
  padding: var(--spacing-xl) 0 var(--spacing-3xl);
}

.archive-timeline-line {
  position: absolute;
  top: var(--spacing-xl);
  bottom: var(--spacing-3xl);
  left: 50%;
  width: 1px;
  background: var(--color-border);
  opacity: 0.8;
  pointer-events: none;
}

.archive-section {
  position: relative;
  margin-bottom: var(--spacing-xl);
}

.archive-year-label {
  position: relative;
  z-index: 1;
  width: max-content;
  margin: 0 auto var(--spacing-xl);
  padding: 0 var(--spacing-md);
  background: var(--color-bg);
  font-size: var(--font-size-lg);
  font-weight: 400;
  letter-spacing: 0.16em;

  a {
    color: var(--color-text);

    &:hover {
      color: var(--color-accent);
    }
  }
}

.archive-post-item {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 50%;
  gap: 2px;
  margin-bottom: var(--spacing-xl);
  padding: 0;
  border: 0;
  transition: padding var(--transition-slow);

  &:hover {
    .archive-timeline-dot {
      background: var(--color-accent);
      transform: scale(1.3);
    }
  }

  time {
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    white-space: nowrap;
    letter-spacing: 0.14em;
  }

  a {
    color: var(--color-text);
    line-height: 1.55;

    &:hover {
      color: var(--color-accent);
    }
  }
}

.archive-timeline-item.is-left {
  margin-right: 50%;
  padding-right: calc(var(--spacing-xl) + var(--spacing-sm));
  text-align: right;

  &:hover {
    padding-right: calc(var(--spacing-xl) + var(--spacing-md));
  }

  .archive-timeline-dot {
    right: -5px;
  }
}

.archive-timeline-item.is-right {
  margin-left: 50%;
  padding-left: calc(var(--spacing-xl) + var(--spacing-sm));
  text-align: left;

  &:hover {
    padding-left: calc(var(--spacing-xl) + var(--spacing-md));
  }

  .archive-timeline-dot {
    left: -5px;
  }
}

.archive-timeline-dot {
  position: absolute;
  top: 0.42rem;
  z-index: 1;
  width: 9px;
  height: 9px;
  border: 2px solid var(--color-bg);
  border-radius: 50%;
  background: var(--color-text-muted);
  transition: background var(--transition), transform var(--transition-slow);
}

.category-list {
  list-style: none;
  padding: 0;
}

.category-item {
  margin-bottom: 0;

  a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--spacing-sm) 0;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);

    &:hover {
      color: var(--color-accent);
      padding-left: var(--spacing-sm);
    }
  }
}

.category-count {
  color: var(--color-text-muted);
  font-size: var(--font-size-xs);
}

.tag-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  align-items: center;

  a {
    padding: 1px 10px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-secondary);

    &:hover {
      color: var(--color-accent);
      border-color: var(--color-accent);
    }
  }
}

.pagination {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: var(--spacing-2xl);

  .page-number {
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
  }

  .extend {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: var(--spacing-sm) 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);

    &:hover {
      color: var(--color-accent);
      transform: translateX(4px);
    }

    &.prev:hover {
      transform: translateX(-4px);
    }
  }

  .space {
    color: var(--color-text-muted);
  }
}

.snapshot-root {
  position: fixed;
  top: 0;
  left: -99999px;
  width: var(--container-width);
  padding: var(--spacing-xl);
  background: var(--color-bg);

  .copy-btn,
  .code-header,
  .headerlink,
  .share-widget {
    display: none !important;
  }

  .post-card.single {
    animation: none !important;
    opacity: 1 !important;
  }
}
