// Code is treated as a small reading instrument: indexed, quiet, and separate
// from the surrounding prose without becoming a visual card.
code {
  font-family: var(--font-mono);
  font-size: 0.88em;
}

:not(pre) > code {
  padding: 0.08em 0.3em;
  background: var(--color-inline-code-bg);
  color: var(--color-inline-code-text);
  border-radius: 0;
}

figure.highlight {
  position: relative;
  margin: calc(var(--spacing-xl) + var(--spacing-sm)) 0;
  padding-right: 3px;
  overflow-x: auto;
  overflow-y: hidden;
  background: var(--color-code-bg);
  border: 0;
  border-radius: 0;
  box-shadow: none;
  transition: background var(--transition-slow), border-color var(--transition-slow);

  // Scroll hints are intentionally soft: code fades into the edge instead of
  // ending against a hard frame.
  &::before,
  &::after {
    position: absolute;
    z-index: 2;
    top: 2.35rem;
    bottom: 0;
    width: 1.4rem;
    pointer-events: none;
    opacity: 0;
    backdrop-filter: blur(0.6px);
    transition: opacity var(--transition);
    content: '';
  }

  &::before {
    left: 0;
    background: linear-gradient(to right, var(--color-code-bg), transparent);
    transform: translateX(var(--code-scroll-offset, 0px));
  }

  &::after {
    right: 0;
    background: linear-gradient(to left, var(--color-code-bg), transparent);
    transform: translateX(var(--code-scroll-offset, 0px));
  }

  &[data-code-left='true']::before,
  &[data-code-right='true']::after {
    opacity: 0.72;
  }

  figcaption {
    padding: var(--spacing-sm) var(--spacing-md);
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    border: 0;

    a {
      float: right;
      color: var(--color-text-secondary);
    }
  }

  table {
    margin: 0;
    border: none;
    min-width: 100%;
    border-collapse: collapse;

    td, th {
      border: none;
      padding: 0;
      vertical-align: top;
    }
  }

  .gutter {
    width: 2.75rem;
    user-select: none;
    text-align: right;
    background: var(--color-bg-secondary);
    border: 0;

    pre {
      margin: 0;
      padding: var(--spacing-md) 0;
      color: var(--color-text-muted);
      font-size: 0.78em;
      line-height: 1.8;
      white-space: pre;

      .line {
        padding: 0 0.7rem;
      }
    }
  }

  .code pre,
  > pre {
    margin: 0;
    padding: var(--spacing-md) calc(var(--spacing-md) + var(--spacing-sm));
    color: var(--color-code-text);
    font-size: 0.84em;
    line-height: 1.8;
    white-space: pre;
    overflow-wrap: normal;
    word-break: normal;
  }
}

.code-header {
  display: flex;
  align-items: center;
  min-height: 2.35rem;
  padding: 0 var(--spacing-md);
  background: var(--color-bg-secondary);
  border: 0;
}

.code-lang {
  min-width: 4rem;
  color: var(--color-text-muted);
  font-family: var(--font-roman);
  font-size: 0.64rem;
  font-variant: small-caps;
  letter-spacing: 0.12em;
  text-transform: lowercase;
}

.code-dots {
  display: inline-flex;
  gap: 4px;
  margin-left: var(--spacing-sm);

  i {
    display: block;
    width: 3px;
    height: 3px;
    border: 1px solid var(--color-text-muted);
    border-radius: 50%;
  }
}

.copy-btn {
  display: inline-flex;
  align-items: center;
  min-height: 1.45rem;
  margin-left: auto;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--color-text-muted);
  font-family: var(--font-roman);
  font-size: 0.64rem;
  font-weight: 200;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  cursor: pointer;
  transition: color var(--transition), border-color var(--transition);

  &:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  &.copied {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  &:focus-visible {
    outline: 1px solid var(--color-accent);
    outline-offset: 3px;
  }
}

.hljs-comment,
.hljs-quote { color: var(--color-text-muted); font-style: italic; }
.hljs-variable,
.hljs-template-variable,
.hljs-attribute,
.hljs-tag,
.hljs-name,
.hljs-selector-id,
.hljs-selector-class,
.hljs-regexp,
.hljs-link { color: var(--color-text-secondary); }
.hljs-number,
.hljs-meta,
.hljs-built_in,
.hljs-type,
.hljs-params { color: #35677d; }
.hljs-string,
.hljs-symbol,
.hljs-bullet { color: #426d38; }
.hljs-title,
.hljs-section { color: #72518c; }
.hljs-keyword,
.hljs-selector-tag { color: var(--color-accent); }
.hljs-literal { color: var(--color-text-secondary); }
.hljs-emphasis { font-style: italic; }
.hljs-strong { font-weight: 400; }
.hljs-deletion { color: var(--color-accent); background: rgba(184, 58, 42, 0.06); }
.hljs-addition { color: #3a6a30; background: rgba(58, 106, 48, 0.06); }
