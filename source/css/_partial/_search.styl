// ===============
// Search Overlay
// ===============
.search-overlay {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 200;
  align-items: flex-start;
  justify-content: center;
  padding: 18vh var(--spacing-lg) 0;
  background: var(--color-overlay);
  backdrop-filter: blur(4px);

  &.active {
    display: flex;
  }
}

.search-modal {
  width: 100%;
  max-width: 560px;
  overflow: hidden;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  animation: fadeIn 0.2s ease;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  padding: var(--spacing-md) var(--spacing-lg);
  border-bottom: 1px solid var(--color-border);
}

.search-icon {
  color: var(--color-text-muted);
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  border: none;
  outline: none;
  font-size: var(--font-size-lg);
  font-family: var(--font-body);
  font-weight: 200;
  color: var(--color-text);
  background: transparent;

  &::placeholder {
    color: var(--color-text-muted);
  }
}

.search-close {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: none;
  background: transparent;
  color: var(--color-text-muted);
  cursor: pointer;

  &:hover {
    color: var(--color-text);
  }
}

.search-results {
  max-height: 380px;
  overflow-y: auto;
}

.search-hint {
  padding: var(--spacing-xl);
  text-align: center;
  color: var(--color-text-muted);
  font-size: var(--font-size-sm);
}

.search-result-item {
  display: block;
  padding: var(--spacing-md) var(--spacing-lg);
  border-bottom: 1px solid var(--color-border);
  outline: none;

  &:hover,
  &:focus,
  &.selected {
    background: var(--color-bg-secondary);
  }

  &:last-child {
    border-bottom: none;
  }
}

.search-result-title {
  margin-bottom: 2px;
  color: var(--color-text);
  font-size: 1rem;
  font-weight: 200;
}

.search-result-date {
  color: var(--color-text-muted);
  font-size: var(--font-size-xs);
}
