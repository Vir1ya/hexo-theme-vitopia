// ===============
// Footer
// ===============
.site-footer {
  border-top: 1px solid var(--color-border);
  padding: var(--spacing-xl) 0;
  transition: border-color var(--transition-slow);

  .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-md);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    letter-spacing: 0.08em;
  }

  a {
    color: var(--color-text-secondary);

    &:hover {
      color: var(--color-accent);
    }
  }
}

.footer-right {
  display: flex;
  gap: var(--spacing-sm);
}

.footer-sep {
  color: var(--color-border);
}

.footer-icp {
  color: var(--color-text-muted);
}

.back-to-top {
  position: fixed;
  right: 2rem;
  bottom: 2rem;
  z-index: 50;
  width: 38px;
  height: 38px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--color-border);
  border-radius: 50%;
  background: var(--color-bg);
  color: var(--color-text-secondary);
  cursor: pointer;
  opacity: 0;
  transform: translateY(12px);
  pointer-events: none;
  transition: opacity var(--transition), transform var(--transition-slow), color var(--transition), border-color var(--transition), background var(--transition-slow);

  &:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  &.visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
}
