// ===============
// Responsive
// ===============
@media (max-width: 768px) {
  html {
    font-size: 16px;
  }

  :root {
    --container-width: 100%;
    --spacing-lg: 1rem;
    --spacing-xl: 1.25rem;
    --spacing-2xl: 2rem;
    --spacing-3xl: 2.5rem;
    --spacing-4xl: 3.5rem;
  }

  .site-nav {
    gap: var(--spacing-md);
  }

  .home-bio {
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: var(--spacing-2xl);
  }

  .home-avatar {
    width: 52px;
    height: 52px;
  }

  .home-bio-text .home-author {
    font-size: var(--font-size-xl);
  }

  .search-modal {
    margin: 0 var(--spacing-md);
    max-width: 100%;
  }

  .site-footer .container {
    flex-direction: column;
    gap: var(--spacing-sm);
    text-align: center;
  }

  .post-nav {
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .post-title {
    font-size: var(--font-size-lg);
  }
}

@media (max-width: 480px) {
  .site-header .container {
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  .header-actions {
    order: 3;
  }

  .post-category {
    font-size: 0.7rem;
    padding: 1px 6px;
  }

  .archive-post-item {
    flex-direction: column;
    gap: 0;

    time {
      min-width: auto;
    }
  }
}
