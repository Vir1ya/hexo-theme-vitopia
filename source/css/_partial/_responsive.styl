// ===============
// Responsive
// ===============
@media (max-width: 768px) {
  html {
    font-size: 16px;
  }

  :root {
    --container-width: 100%;
    --spacing-lg: 1rem;
    --spacing-xl: 1.25rem;
    --spacing-2xl: 2rem;
    --spacing-3xl: 2.5rem;
    --spacing-4xl: 3.5rem;
  }

  .site-nav {
    gap: var(--spacing-md);
  }

  .home-stage {
    min-height: auto;
    padding: var(--spacing-2xl) 0;
  }

  .home-profile,
  .home-posts {
    max-width: 100%;
  }

  .home-avatar-wrap {
    min-width: 82px;
    min-height: 82px;
    margin-bottom: var(--spacing-lg);
  }

  .home-avatar {
    width: 82px;
    height: 82px;
  }

  .home-author-link,
  .post-card.single .post-title {
    font-size: var(--font-size-2xl);
  }

  .home-bio-desc,
  .post-body {
    font-size: var(--font-size-sm);
  }

  .search-modal {
    max-width: 100%;
  }

  .site-footer .container {
    flex-direction: column;
    text-align: center;
  }

  .post-nav {
    grid-template-columns: 1fr;
    gap: 0;
  }
}

@media (max-width: 560px) {
  .site-header {
    height: auto;
    min-height: var(--header-height);

    .container {
      flex-wrap: wrap;
      gap: var(--spacing-sm);
      padding-top: var(--spacing-sm);
      padding-bottom: var(--spacing-sm);
    }
  }

  .site-nav {
    order: 3;
    width: 100%;
    justify-content: center;
  }

  .main-content {
    padding-top: calc(var(--header-height) + var(--spacing-4xl));
  }
}

@media (max-width: 480px) {
  .container {
    padding: 0 var(--spacing-md);
  }

  .home-stage {
    padding-top: var(--spacing-xl);
  }

  .home-link {
    padding: 0;
  }

  .post-card:hover,
  .archive-post-item:hover,
  .category-item a:hover {
    padding-left: 4px;
  }

  .archive-post-item {
    flex-direction: column;
    gap: 0;

    time {
      min-width: auto;
    }
  }

  .post-footer {
    align-items: flex-start;
    flex-direction: column;
  }
}

@media (max-width: 640px) {
  .archive-timeline {
    padding-left: 2rem;
  }

  .archive-timeline-line {
    left: 8px;
  }

  .archive-year-label {
    margin-left: 0;
    padding-left: 0;
  }

  .archive-timeline-item.is-left,
  .archive-timeline-item.is-right {
    width: 100%;
    margin-right: 0;
    margin-left: 0;
    padding-right: 0;
    padding-left: var(--spacing-lg);
    text-align: left;

    &:hover {
      padding-right: 0;
      padding-left: calc(var(--spacing-lg) + var(--spacing-xs));
    }

    .archive-timeline-dot {
      right: auto;
      left: calc(-2rem + 4px);
    }
  }
}
